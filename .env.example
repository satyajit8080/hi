# ─── Core ───────────────────────────────────────────────────────────────────
SP_ENV=local
# production: comma-separated browser origins allowed to call the API, e.g. https://signals.example.com
SP_CORS_ORIGINS=
SP_LOG_LEVEL=info
SP_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
SP_ACCESS_TOKEN_MINUTES=30
SP_REFRESH_TOKEN_DAYS=30

# ─── Storage ────────────────────────────────────────────────────────────────
POSTGRES_USER=signalproof
POSTGRES_PASSWORD=signalproof
POSTGRES_DB=signalproof
SP_DATABASE_URL=postgresql+asyncpg://signalproof:signalproof@db:5432/signalproof
SP_REDIS_URL=redis://redis:6379/0

# ─── Market data ────────────────────────────────────────────────────────────
# MODE: "replay" runs the whole stack on the bundled simulated dataset (no keys
# needed, everything in the UI is labelled SIMULATED). "live" uses public
# exchange WebSockets — no API keys are required for public market data.
SP_MARKET_MODE=replay
SP_PRIMARY_VENUE=binance
SP_VENUES=binance,coinbase,okx,bybit   # any of: binance coinbase okx bybit
SP_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
SP_REPLAY_SPEED=60           # replay seconds per wall-clock second
SP_ORDERBOOK_DEPTH=20

# Optional. Public market data needs no key; these are only for private/rate-
# lifted endpoints and are never required to run the platform.
BINANCE_API_KEY=
BINANCE_API_SECRET=
COINBASE_API_KEY=
COINBASE_API_SECRET=

# ─── Derivatives / on-chain context (all optional; V2/V3 per research) ──────
# Coinglass commercial use starts at the $299 Standard tier — do not point this
# at a personal-use key in production.
COINGLASS_API_KEY=
COINGLASS_TIER=none          # none | standard | professional
HYPERLIQUID_API_URL=https://api.hyperliquid.xyz
SP_SMART_MONEY_ENABLED=true
# Smart-money features are CONTEXT-ONLY until out-of-sample cohort validation
# passes. Flipping this to true without a passing validation record is refused
# by the engine at startup.
SP_SMART_MONEY_IS_SIGNAL_DRIVER=false

# ─── Engine ─────────────────────────────────────────────────────────────────
SP_STRATEGY_VERSION=1.1.0
SP_MIN_RR=1.5
SP_MIN_CALIBRATION_SAMPLE=30
SP_MAX_BOOK_STALENESS_MS=5000
SP_MAX_TRADE_STALENESS_MS=10000
SP_MAX_CLOCK_SKEW_MS=2000
SP_MIN_LIVE_VENUES=2
# Cross-venue mid-price gap (percent) above which the feed is marked degraded: 0.5 (hub default)
SP_FREE_TIER_DELAY_MINUTES=60
SP_FREE_TIER_HISTORY_DAYS=30

# ─── Alerts (optional) ──────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com
SMTP_URL=

# ─── Billing (optional; credentials stay external) ──────────────────────────
SP_BILLING_PROVIDER=none     # none | stripe | razorpay | paddle
SP_PRO_PRICE_USD=10
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=

# ─── Anchoring ──────────────────────────────────────────────────────────────
SP_ANCHOR_PROVIDER=local     # local | opentimestamps
SP_OTS_CALENDAR_URLS=https://alice.btc.calendar.opentimestamps.org

# ─── Frontend ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/market
